    <!-- Chat hint bubble â€” the typewriter teaser ("Hi, how can I help? ğŸ‘‹")
         that pops up beside the chat launcher. Commented out alongside the
         chat-widget SDK above: it is triggered by data-chat-widget-visible
         and points at #workly-chat-btn, which that disabled script is what
         injects, so on its own it would tease a button that never appears.
         Re-enable both together. The #chat-hint-bubble / .bubble-* CSS is
         left in place â€” it is inert without this markup. -->
    <!--
    <div id="chat-hint-bubble" aria-hidden="true">
      <div class="bubble-typing"><span></span><span></span><span></span></div>
      <div class="bubble-text">
        <span class="bubble-text-dot"></span>
        <span class="bubble-typewriter"></span
        ><span class="bubble-cursor"></span>
      </div>
    </div>
    <script>
      (function () {
        var bubble = document.getElementById("chat-hint-bubble");
        var bTyping = bubble.querySelector(".bubble-typing");
        var bText = bubble.querySelector(".bubble-text");
        var bWriter = bubble.querySelector(".bubble-typewriter");
        var bCursor = bubble.querySelector(".bubble-cursor");
        var html = document.documentElement;
        var timers = [];
        var dismissed = false;
        var started = false;
        var MESSAGE = "Hi, how can I help? ğŸ‘‹";

        function clr() {
          timers.forEach(clearTimeout);
          timers = [];
        }
        function after(fn, ms) {
          var id = setTimeout(fn, ms);
          timers.push(id);
        }

        function dismiss() {
          dismissed = true;
          clr();
          bubble.classList.remove("visible");
          bText.classList.remove("show");
          bWriter.textContent = "";
          /* Always ensure button is visible when dismissed */
          html.classList.add("chat-btn-ready");
        }

        function typeText(cb) {
          /* Split message into grapheme-safe chunks (handles emoji) */
          var chars = Array.from(MESSAGE);
          var i = 0;
          bWriter.textContent = "";
          bCursor.style.display = "inline-block";

          function next() {
            if (dismissed) return;
            if (i < chars.length) {
              bWriter.textContent += chars[i++];
              after(next, i === chars.length ? 0 : 55 + Math.random() * 30);
            } else {
              /* Hide cursor after done, then call back */
              after(function () {
                bCursor.style.display = "none";
                cb();
              }, 600);
            }
          }
          next();
        }

        function showCycle() {
          if (dismissed) return;

          /* Reset */
          bWriter.textContent = "";
          bText.classList.remove("show");
          bTyping.style.display = "flex";
          bCursor.style.display = "none";

          /* Expand bubble with dots */
          bubble.classList.add("visible");

          /* After 1.4s: swap dots â†’ typewriter */
          after(function () {
            if (dismissed) return;
            bTyping.style.display = "none";
            bText.classList.add("show");

            typeText(function () {
              /* Pause 3s then shrink away */
              after(function () {
                if (dismissed) return;
                bText.classList.remove("show");
                bubble.classList.remove("visible");
                /* 7s gap then loop */
                after(showCycle, 7000);
              }, 3000);
            });
          }, 1400);
        }

        function start() {
          if (started || dismissed) return;
          started = true;
          /* Button appears fast (300ms), bubble loop starts after button is in */
          after(function () {
            html.classList.add("chat-btn-ready");
          }, 300);
          after(showCycle, 1200);
        }

        /* Stop the cycle and reset bubble state so a future visit to a
           widget-enabled route can restart it from scratch. CSS already
           hides the bubble when the attribute is absent, but the setTimeout
           chain would otherwise keep running invisibly. */
        function stop() {
          clr();
          started = false;
          bubble.classList.remove("visible");
          bText.classList.remove("show");
          bWriter.textContent = "";
        }

        var mo = new MutationObserver(function () {
          if (html.getAttribute("data-chat-widget-visible") === "true") start();
          else stop();
        });
        mo.observe(html, {
          attributes: true,
          attributeFilter: ["data-chat-widget-visible"],
        });
        if (html.getAttribute("data-chat-widget-visible") === "true") start();

        document.addEventListener("click", function (e) {
          if (
            e.target.closest &&
            (e.target.closest("#workly-chat-btn") ||
              e.target.closest("#chat-hint-bubble"))
          ) {
            dismiss();
          }
        });
      })();
    </script>
