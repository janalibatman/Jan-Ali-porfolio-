.fv-pptx-toolbar { display: flex; gap: 4px; padding: 6px 8px; border-bottom: 1px solid var(--panel-border); background: var(--panel-chrome-bg); flex-shrink: 0; }

.fv-pptx-mode-btn { padding: 4px 12px; font-size: 12px; border-radius: 6px; border: 1px solid transparent; background: transparent; color: var(--txt-secondary); cursor: pointer; }

.fv-pptx-mode-btn:hover { background: var(--surface-hover); color: var(--txt-primary); }

.fv-pptx-mode-btn.active { background: var(--surface-tertiary); color: var(--txt-primary); border-color: var(--panel-border); }

.fv-pptx-cols { display: flex; flex: 1 1 0%; min-height: 0px; }

.fv-pptx-rail { flex-shrink: 0; width: 182px; overflow: hidden auto; padding: 10px 8px; display: flex; flex-direction: column; gap: 10px; border-right: 1px solid var(--panel-border); background: var(--panel-chrome-bg); }

.fv-pptx-rail--h { width: 100%; max-width: 100%; flex-direction: row; align-items: flex-end; overflow: auto hidden; padding: 6px 8px; gap: 8px; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; background: transparent; scrollbar-width: none; }

.fv-pptx-rail--h::-webkit-scrollbar { display: none; }

.fv-pptx-rail--h .fv-pptx-thumb { flex-direction: column-reverse; align-items: center; gap: 2px; }

.fv-pptx-rail--h .fv-pptx-thumb-num { width: auto; padding-top: 0px; font-size: 10px; line-height: 1; }

.fv-pptx-thumb { display: flex; align-items: flex-start; gap: 6px; padding: 0px; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; text-align: left; }

.fv-pptx-thumb-num { width: 16px; flex-shrink: 0; padding-top: 2px; font-size: 11px; color: var(--txt-muted); font-variant-numeric: tabular-nums; }

.fv-pptx-thumb-frame { overflow: hidden; background: rgb(255, 255, 255); border: 1px solid var(--panel-border); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 3px; transition: border-color 0.12s, box-shadow 0.12s; }

.fv-pptx-thumb:hover .fv-pptx-thumb-frame { border-color: var(--accent); }

.fv-pptx-thumb.active .fv-pptx-thumb-frame { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }

.fv-pptx-thumb.active .fv-pptx-thumb-num { color: var(--txt-primary); font-weight: 600; }

.fv-pptx-stage { position: relative; flex: 1 1 0%; min-height: 0px; overflow: hidden auto; }

.fv-pptx-body { width: 100%; }

.fv-tabs { display: flex; gap: 2px; padding: 0px 8px 6px; border-top: 1px solid var(--panel-border); background: var(--panel-chrome-bg); overflow-x: auto; flex-shrink: 0; }

.fv-tab { padding: 5px 12px; border-radius: 0px 0px 6px 6px; font-size: 12px; color: var(--txt-secondary); background: transparent; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor transparent transparent; border-image: none; cursor: pointer; white-space: nowrap; user-select: none; }

.fv-tab:hover { background: var(--surface-hover); }

.fv-tab.active { color: var(--txt-primary); background: var(--surface-tertiary); border-color: var(--panel-border); }
