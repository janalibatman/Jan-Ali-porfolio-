* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { background: var(--bg-primary); }

body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif; background: var(--bg-primary); color: var(--text-primary); }

::-webkit-scrollbar { width: 6px; height: 6px; background: transparent; }

::-webkit-scrollbar-track { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: none; }

::-webkit-scrollbar-track-piece { background: transparent; }

::-webkit-scrollbar-thumb { background: transparent; border-radius: 3px; transition: background 0.3s; }

:hover::-webkit-scrollbar-thumb { background: var(--border); }

::-webkit-scrollbar-thumb:hover { background: var(--border-light); }

::-webkit-scrollbar-button { display: none; width: 0px; height: 0px; }

::-webkit-scrollbar-corner { background: transparent; }

.sidebar-type { font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.5; letter-spacing: 0px; }

@media (min-width: 768px) {
  .sidebar-type { font-size: 14.5px; }
}

.sidebar-type--medium { font-weight: 500; }

.sidebar-type--regular { font-weight: 400; }

.sidebar-img-icon { display: inline-block; flex-shrink: 0; width: 20px; height: 20px; background-image: var(--icon-dark); background-repeat: no-repeat; background-position: center center; background-size: contain; }

[data-theme="light"] .sidebar-img-icon { background-image: var(--icon-light); }

html.app-scroll-locked, html.app-scroll-locked body { height: 100%; overflow: hidden; overscroll-behavior: none; }

html.app-scroll-locked body { position: fixed; top: var(--app-vv-top, 0px); left: 0px; right: 0px; width: 100%; height: var(--app-vh, 100%); }

html, * { scrollbar-color: transparent transparent; scrollbar-width: thin; }

:hover { scrollbar-color: var(--border) transparent; }

.is-scrolling::-webkit-scrollbar-thumb { background: var(--border); }

.is-scrolling { scrollbar-color: var(--border) transparent; }

.scrollbar-autohide::-webkit-scrollbar-thumb:hover { background: var(--border-light); }

.pills-scroll::-webkit-scrollbar { display: none; }

.md-content { overflow-wrap: break-word; word-break: break-word; font-size: 17px; line-height: 28px; font-family: sans-serif; }

.md-content p { margin: 0px 0px 18px; }

.md-content p:last-child { margin-bottom: 0px; }

.md-content h1, .md-content h2, .md-content h3, .md-content h4, .md-content h5, .md-content h6 { margin: 16px 0px 8px; font-weight: 600; line-height: 1.3; }

.md-content h1 { font-size: 1.4em; border-bottom: 1px solid var(--border); padding-bottom: 6px; }

.md-content h2 { font-size: 1.25em; border-bottom: 1px solid var(--border); padding-bottom: 4px; }

.md-content h3 { font-size: 1.1em; }

.md-content code { background: var(--bg-tertiary); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; font-family: "SF Mono", "Fira Code", "Cascadia Code", Consolas, monospace; color: var(--code-inline); }

.md-content pre { background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: 6px; overflow-x: auto; margin: 12px 0px; position: relative; max-width: 100%; }

.md-content pre code { display: block; padding: 14px 16px; background: none; color: var(--text-primary); font-size: 13px; line-height: 1.5; border-radius: 0px; }

.md-content ul, .md-content ol { padding-left: 24px; margin: 8px 0px; }

.md-content li { margin: 4px 0px; }

.md-content li > ul, .md-content li > ol { margin: 2px 0px; }

.md-content li > p { margin: 4px 0px; }

.md-content blockquote { border-left: 3px solid var(--accent); margin: 10px 0px; padding: 6px 14px; color: var(--text-secondary); background: var(--accent-bg); border-radius: 0px 6px 6px 0px; }

.md-content a { color: var(--accent); text-decoration: none; }

.md-content a:hover { text-decoration: underline; }

